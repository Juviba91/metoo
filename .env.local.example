NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Necesaria solo para el panel de /admin (lib/supabase/admin.ts).
# NUNCA la expongas al cliente ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Secretos de las Edge Functions -----------------------------------------
# Estos NO van en .env.local: se configuran con `supabase secrets set`.
#
#   supabase secrets set RESEND_API_KEY=re_tu_clave
#   supabase secrets set APP_URL=https://tu-dominio.com
#   supabase secrets set CRON_SECRET=una_cadena_larga_y_aleatoria
#
# APP_URL      construye los enlaces de los emails.
# CRON_SECRET  protege process-email-queue, que provoca envío de correo.
